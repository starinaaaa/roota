# Runtime secrets: set through Timeweb environment settings; never commit real values.
APP_ENV=migration
DATABASE_URL=
# Optional: keep DATABASE_URL without a password and supply its UTF-8 base64 here.
# This is a secret, not encryption; never prefix it with NEXT_PUBLIC_.
DATABASE_PASSWORD_BASE64=
DATABASE_CA_FILE=
# For managed app environments without secret files: base64 of the official CA PEM.
DATABASE_CA_BASE64=
DATABASE_POOL_MAX=4
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BETTER_AUTH_URL=https://roota.moscow
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
NEXT_PUBLIC_SITE_URL=https://roota.moscow
JOBS_ENABLED=false
CRON_SECRET=
ROBOKASSA_MODE=off
ROBOKASSA_TEST_RESULT2=false
ROBOKASSA_LIVE_ENABLED=false
ROBOKASSA_SMZ_READY=false
OZON_SHIPMENTS_ENABLED=false
NOTIFICATIONS_ENABLED=false
STUDIO_NOTIFICATION_CHANNEL=email
# Optional temporary Telegram relay; server secrets, never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RELAY_KEY=
MIGRATION_MAINTENANCE=false

# Yandex Maps JavaScript API key; restrict allowed domains in the Yandex developer dashboard.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Unisender Go — secret, server-side only. Customer flows stay disabled until ready.
UNISENDER_GO_API_KEY=
CUSTOMER_EMAILS_ENABLED=false
# Isolated projects: order_* → SERVICE; voluntary subscriptions → MARKETING.
# Once either is set, a missing project key fails closed; no shared-key fallback.
UNISENDER_GO_SERVICE_API_KEY=
UNISENDER_GO_MARKETING_API_KEY=

# Refund API: server-only Password3 from Robokassa, separate from payment passwords.
ROBOKASSA_PASSWORD3=
