{
  "manifest_version": 3,
  "name": "Roota · помощник чеков НПД",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Локальная подготовка чеков маркета в интерфейсе Моего налога. По умолчанию без регистрации дохода.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://roota.moscow/*", "https://lknpd.nalog.ru/*"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Roota · чеки маркета"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
