{
  "name": "roota",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sales-preview.mjs build",
    "start": "node scripts/sales-preview.mjs start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "migration:backup": "node --env-file=.env.local --env-file=.env.migration.local --import tsx scripts/migration/backup.ts",
    "migration:restore-drill": "node --env-file=.env.migration.local --import tsx scripts/migration/restore-backup.ts",
    "migration:export": "node --env-file=.env.migration.local --import tsx scripts/migration/export.ts",
    "migration:import": "node --env-file=.env.migration.local --import tsx scripts/migration/import.ts",
    "migration:storage": "node --env-file=.env.migration.local --import tsx scripts/migration/storage.ts",
    "migration:verify": "node --env-file=.env.migration.local --import tsx scripts/migration/verify.ts",
    "dev:preview": "node scripts/sales-preview.mjs dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@robokassa/sdk": "1.0.0",
    "better-auth": "1.7.9",
    "embla-carousel-react": "8.6.0",
    "embla-carousel-wheel-gestures": "8.1.0",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "2.99.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yandex-maps": "^2.1.36",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
